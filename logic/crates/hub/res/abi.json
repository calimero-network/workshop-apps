{
  "schema_version": "wasm-abi/1",
  "types": {
    "CommunitySummary": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "topic",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "context_id",
          "type": {
            "kind": "string"
          },
          "nullable": true
        },
        {
          "name": "created_by",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "member_count",
          "type": {
            "kind": "u64"
          }
        },
        {
          "name": "created_at",
          "type": {
            "kind": "u64"
          }
        }
      ]
    },
    "Event_CommunityDeleted": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_CommunityRegistered": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "Event_CommunityStatsUpdated": {
      "kind": "record",
      "fields": [
        {
          "name": "id",
          "type": {
            "kind": "string"
          }
        }
      ]
    },
    "HubState": {
      "kind": "record",
      "fields": [
        {
          "name": "communities",
          "type": {
            "kind": "map",
            "key": {
              "kind": "string"
            },
            "value": {
              "$ref": "CommunitySummary"
            },
            "crdt_type": "unordered_map"
          }
        }
      ]
    }
  },
  "methods": [
    {
      "name": "init",
      "params": [],
      "returns": {
        "kind": "unit"
      }
    },
    {
      "name": "register_community",
      "params": [
        {
          "name": "community_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "name",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "topic",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "context_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "$ref": "CommunitySummary"
      }
    },
    {
      "name": "get_communities",
      "params": [],
      "returns": {
        "kind": "list",
        "items": {
          "$ref": "CommunitySummary"
        }
      }
    },
    {
      "name": "update_community_stats",
      "params": [
        {
          "name": "community_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "member_count",
          "type": {
            "kind": "u64"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      }
    },
    {
      "name": "delete_community",
      "params": [
        {
          "name": "community_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "unit"
      }
    }
  ],
  "events": [
    {
      "name": "CommunityRegistered",
      "payload": {
        "$ref": "Event_CommunityRegistered"
      }
    },
    {
      "name": "CommunityStatsUpdated",
      "payload": {
        "$ref": "Event_CommunityStatsUpdated"
      }
    },
    {
      "name": "CommunityDeleted",
      "payload": {
        "$ref": "Event_CommunityDeleted"
      }
    }
  ],
  "state_root": "HubState"
}